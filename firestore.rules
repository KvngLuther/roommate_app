rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != null
        && request.auth.uid != null;

      // meta/data must be readable/writable BEFORE a user is bound to the
      // household — it's what tracks which roommate slots are claimed, so
      // it has to be accessible during household creation and while a user
      // is still deciding which slot to join.
      match /meta/{docId} {
        allow read, write: if request.auth != null;
      }

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.token.name != null
          && request.auth.token.name.split(':')[0] == householdId;
      }
    }
  }
}